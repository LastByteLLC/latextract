{
  "name": "latextract-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "build:grammar": "lark-js ../src/latextract/grammar/latex_math.lark -o src/grammar/parser.js",
    "build:all": "npm run build:grammar && npm run build"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.0.0",
    "katex": "^0.16.11",
    "workbox-cacheable-response": "^7.1.0",
    "workbox-expiration": "^7.1.0",
    "workbox-precaching": "^7.1.0",
    "workbox-routing": "^7.1.0",
    "workbox-strategies": "^7.1.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.20.0"
  }
}
